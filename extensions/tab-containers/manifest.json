{
  "manifest_version": 2,
  "name": "PosterFox Tab Containers",
  "version": "1.0.0",
  "description": "Every tab is its own temporary container: its own cookies and storage, deleted when the tab closes.",
  "browser_specific_settings": { "gecko": { "id": "tab-containers@posterfox.poster.place", "strict_min_version": "128.0" } },
  "permissions": ["contextualIdentities", "cookies", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"],
  "background": { "scripts": ["containers.js", "background.js"] }
}
